{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rackmcp.local/schemas/probe-reading.schema.json",
  "description": "Rack MCP probe telemetry reading",
  "type": "object",
  "properties": {
    "probeModuleId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "probeInputId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "connected": {
      "type": "boolean"
    },
    "channelCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "sampleRate": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "windowFrames": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "channels": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "peakAbs": {
            "type": "number"
          },
          "rms": {
            "type": "number"
          },
          "mean": {
            "type": "number"
          },
          "clippedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "nonFiniteCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "edgeCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "min",
          "max",
          "peakAbs",
          "rms",
          "mean",
          "clippedCount",
          "nonFiniteCount"
        ],
        "additionalProperties": false
      }
    },
    "droppedFrames": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "probeModuleId",
    "probeInputId",
    "connected",
    "channelCount",
    "sampleRate",
    "windowFrames",
    "channels",
    "droppedFrames",
    "sequence"
  ],
  "additionalProperties": false
}
