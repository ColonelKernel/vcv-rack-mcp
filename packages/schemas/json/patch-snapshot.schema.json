{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rackmcp.local/schemas/patch-snapshot.schema.json",
  "description": "Rack MCP patch snapshot",
  "type": "object",
  "properties": {
    "rackVersion": {
      "type": "string",
      "maxLength": 64
    },
    "rackEdition": {
      "type": "string",
      "enum": [
        "Free",
        "Pro",
        "unknown"
      ]
    },
    "instanceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "patchEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "patchName": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "saved": {
      "type": "boolean"
    },
    "sampleRate": {
      "type": "number",
      "minimum": 0
    },
    "modules": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "moduleId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          },
          "pluginSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "pluginVersion": {
            "type": "string",
            "maxLength": 64
          },
          "modelSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "modelName": {
            "type": "string",
            "maxLength": 256
          },
          "bypassed": {
            "type": "boolean"
          },
          "isBridge": {
            "type": "boolean"
          },
          "isProbe": {
            "type": "boolean"
          },
          "gridPosition": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -4096,
                    "maximum": 4096
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -256,
                    "maximum": 256
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "gridWidth": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1024
              },
              {
                "type": "null"
              }
            ]
          },
          "params": {
            "maxItems": 4096,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "paramId": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "name": {
                  "type": "string",
                  "maxLength": 256
                },
                "value": {
                  "type": "number"
                },
                "minValue": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maxValue": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "defaultValue": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "normalizedValue": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "displayValue": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 256
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unit": {
                  "type": "string",
                  "maxLength": 64
                },
                "snapped": {
                  "type": "boolean"
                }
              },
              "required": [
                "paramId",
                "name",
                "value",
                "minValue",
                "maxValue",
                "defaultValue",
                "normalizedValue",
                "displayValue",
                "unit",
                "snapped"
              ],
              "additionalProperties": false
            }
          },
          "inputs": {
            "maxItems": 1024,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "portId": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "input",
                    "output"
                  ]
                },
                "name": {
                  "type": "string",
                  "maxLength": 256
                },
                "channels": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16
                },
                "connected": {
                  "type": "boolean"
                }
              },
              "required": [
                "portId",
                "type",
                "name",
                "channels",
                "connected"
              ],
              "additionalProperties": false
            }
          },
          "outputs": {
            "maxItems": 1024,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "portId": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "input",
                    "output"
                  ]
                },
                "name": {
                  "type": "string",
                  "maxLength": 256
                },
                "channels": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16
                },
                "connected": {
                  "type": "boolean"
                }
              },
              "required": [
                "portId",
                "type",
                "name",
                "channels",
                "connected"
              ],
              "additionalProperties": false
            }
          },
          "expanders": {
            "type": "object",
            "properties": {
              "left": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,18})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "right": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,18})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "left",
              "right"
            ],
            "additionalProperties": false
          },
          "opaqueState": {},
          "opaqueStateDisclosed": {
            "type": "boolean"
          }
        },
        "required": [
          "moduleId",
          "pluginSlug",
          "pluginVersion",
          "modelSlug",
          "modelName",
          "bypassed",
          "isBridge",
          "isProbe",
          "gridPosition",
          "gridWidth",
          "params",
          "inputs",
          "outputs",
          "expanders"
        ],
        "additionalProperties": false
      }
    },
    "cables": {
      "maxItems": 16384,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cableId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          },
          "outputModuleId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          },
          "outputId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "inputModuleId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          },
          "inputId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "color": {
            "anyOf": [
              {
                "type": "string",
                "const": ""
              },
              {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$"
              }
            ]
          }
        },
        "required": [
          "cableId",
          "outputModuleId",
          "outputId",
          "inputModuleId",
          "inputId",
          "color"
        ],
        "additionalProperties": false
      }
    },
    "bridgeModuleCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "probeModuleCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      }
    }
  },
  "required": [
    "rackVersion",
    "rackEdition",
    "instanceId",
    "sessionId",
    "patchEpoch",
    "patchName",
    "saved",
    "sampleRate",
    "modules",
    "cables",
    "bridgeModuleCount",
    "probeModuleCount",
    "fingerprint",
    "warnings"
  ],
  "additionalProperties": false
}
